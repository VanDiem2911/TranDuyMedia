# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Showreel 4K gốc (~1.1GB) — không commit; bản web đã nén nằm ở public/media (npm run video)
/public/videos/

# Ảnh gốc HD khách gửi (~160MB) — không commit; bản web WebP nằm ở public/images/about-hd
/public/images/images_real/

# cloudflare / opennext
/.open-next/
/.wrangler/
.dev.vars

# Bản sao lưu showreel gốc (không đưa lên Git / Cloudflare)
/_backup/
